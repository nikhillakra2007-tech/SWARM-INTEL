# Swarm Intelligence Lending Network — environment template
# Copy to .env and fill values. Never commit .env.
# Used by database/scripts/*.ps1 and future backend.

# Local PostgreSQL (psql) connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swarm_lending

# Alternative discrete vars (if DATABASE_URL not used)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swarm_lending
DB_USER=postgres
DB_PASSWORD=postgres

# Future Supabase (when integrating later — NOT required now)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
